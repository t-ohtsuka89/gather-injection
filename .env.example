# スクリプト実行の設定
GATHER_SCRIPT_MAX_SIZE=1048576  # 1MB
GATHER_SCRIPT_TIMEOUT=30.0      # 30秒

# ネットワーク関連の設定
GATHER_WINDOW_TIMEOUT=60
GATHER_GAME_OBJECT_TIMEOUT=20
GATHER_TARGET_URL=https://app.gather.town
GATHER_MAX_ATTEMPTS_DEBUG_PORT=30
GATHER_DEBUG_PORT_DELAY=1

# アプリケーション全般の設定
GATHER_APP_NAME=Gather
GATHER_LOG_LEVEL=INFO
GATHER_RETRY_COUNT=3
GATHER_RETRY_DELAY=1.0
